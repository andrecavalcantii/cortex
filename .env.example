# Copie para .env e preencha o que quiser. Tudo é opcional.

# Chat dentro da página (pago à parte, em console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Quem é você: o Claude usa pra saber com quem está falando
CORTEX_DONO=
CORTEX_SOBRE=

# Porta do mapa e pasta das anotações (padrão: 3333 e ./cerebro)
PORT=3333
# CORTEX_DIR=/caminho/para/outro/cerebro
